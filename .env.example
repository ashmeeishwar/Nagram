# Nagram — environment variables
# Copy this file to `.env` and fill in your Supabase project values.
# Find these in your Supabase dashboard under: Project Settings → API.
#
# The `.env` file is git-ignored and must never be committed.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project "anon" public API key (safe for client use with RLS).
VITE_SUPABASE_ANON_KEY=
